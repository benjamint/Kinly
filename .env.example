# Copy to .env for local dev, and add the same values in Vercel → Settings → Environment Variables.
# Without any of these, Kinly still runs in demo mode (everything on the device, phone's own voice).

# Supabase (server only, never exposed to the browser)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional: pick a warm voice from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Optional: the LLM the agent uses (pick the newest Claude model listed in the ElevenLabs agent settings)
KINLY_AGENT_LLM=

# Shared secret ElevenLabs sends to /api/tools/* (any long random string)
KINLY_TOOL_SECRET=
# Where the app is deployed, used by `npm run sync-agent` for the tool URLs
KINLY_PUBLIC_URL=https://your-app.vercel.app
